# ==============================================================
# Aroham Foundation Database Configuration
# ==============================================================

# --------------------------------------------------------------
# MongoDB Database Configuration (Local MongoDB or MongoDB Atlas)
# --------------------------------------------------------------
# Local MongoDB (Compass / local service):
MONGODB_URI=mongodb://127.0.0.1:27017/aroham
MONGODB_DATABASE=aroham

# Or MongoDB Atlas Cloud Connection String:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aroham?retryWrites=true&w=majority

# --------------------------------------------------------------
# Server Port
# --------------------------------------------------------------
PORT=5000

# ==============================================================
# Aroham Foundation Database Configuration
# ==============================================================

# --------------------------------------------------------------
# 1. MongoDB Configuration (Local or MongoDB Atlas Cloud)
# --------------------------------------------------------------
# Local MongoDB (Default)
MONGODB_URI=mongodb://127.0.0.1:27017/aroham
MONGODB_DB_NAME=aroham

# MongoDB Atlas (Cloud Cluster - Uncomment and set your Atlas URI):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/aroham?retryWrites=true&w=majority

# --------------------------------------------------------------
# 2. MySQL Configuration (Local or Cloud MySQL / PlanetScale / AWS RDS)
# --------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=aroham

# Or full MySQL connection string URL (optional):
# MYSQL_URL=mysql://root:password@127.0.0.1:3306/aroham

# --------------------------------------------------------------
# 3. Server Port
# --------------------------------------------------------------
PORT=5000
